# ==============================================================================
# Enterprise Document RAG - Environment Variables Template
# Copy this file to .env and insert your API keys.
# ==============================================================================

# --- LLM Provider Selection ---
# Options: "groq" or "gemini"
LLM_PROVIDER=groq

# --- Groq Configuration (Fast Inference) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIM=768

# --- Qdrant Vector Database ---
# Local in-memory dev: ":memory:" or local folder path "./qdrant_data"
# Remote / Docker: set QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks

# --- RAG Agent Controls ---
CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_TOP_K=4

# --- Future Phases (Optional / Deferred) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# OPENSEARCH_URL=http://localhost:9200
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
